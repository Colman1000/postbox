# ─────────────────────────────────────────────────────────────────────────────
#  Postbox — required configuration
#
#  Copy to `.env` and fill in the three values below. That is the whole setup.
#  Everything else in this file is optional and has a derived default.
#
#      cp .env.example .env && just up
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] The domain you send and receive mail on. Must already be a zone in
# your Cloudflare account (nameservers pointing at Cloudflare).
#   e.g. DOMAIN=acme.dev  ->  you@acme.dev, mail hosted at mail.acme.dev
DOMAIN=

# [REQUIRED] Cloudflare API token.
#   Create one at https://dash.cloudflare.com/profile/api-tokens using the
#   "Edit Cloudflare Workers" template, then ADD these permissions:
#     Account -> Workers Scripts       -> Edit
#     Account -> Workers KV Storage    -> Edit
#     Account -> D1                    -> Edit
#     Account -> Email Routing Addresses -> Edit
#     Zone    -> Zone                  -> Read
#     Zone    -> DNS                   -> Edit
#     Zone    -> Email Routing Rules   -> Edit
#     Zone    -> Workers Routes        -> Edit
#   Or let Alchemy mint one for you:  just login
CLOUDFLARE_API_TOKEN=

# [REQUIRED] Resend API key with **Full access** (https://resend.com/api-keys).
#   Used ONCE, at provision time, to register your domain and to mint a
#   narrower send-only key. The send-only key is what the app actually runs on;
#   it is cached in .secrets/ and reused on every later deploy.
#   Resend's free tier: 3,000 emails/month, 100/day. No card required.
RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
#  Optional — every one of these is derived if you leave it blank.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment stage. Lets you run an isolated copy (`prod`, `staging`, `pr-42`).
# Resources are suffixed with it, so stages never collide.
#   default: prod
# STAGE=prod

# Where the UI is served from.
#   default: mail.$DOMAIN  (a free Cloudflare custom domain on your zone)
# APP_HOSTNAME=mail.acme.dev

# The identity Compose starts with.
#   default: hello@$DOMAIN
# DEFAULT_FROM=hello@acme.dev

# Also forward every inbound message to a normal mailbox, as a safety net.
# Cloudflare emails this address a one-click verification link the first time.
# Leave blank to keep all mail exclusively inside Postbox.
# FORWARD_TO=you@gmail.com

# Resend region for the sending domain: us-east-1 | eu-west-1 | sa-east-1 | ap-northeast-1
#   default: us-east-1
# RESEND_REGION=us-east-1

# Who sends your outgoing mail.
#
#   resend      (default) Free. 100/day, 3,000/month. Works on a free
#               Cloudflare account. Needs RESEND_API_KEY above.
#
#   cloudflare  Cloudflare's own Email Sending. No third party and no second
#               credential, but it REQUIRES THE WORKERS PAID PLAN ($5/month),
#               so it is not free. On this setting RESEND_API_KEY is ignored
#               and you can leave it blank — DOMAIN and CLOUDFLARE_API_TOKEN
#               are then the only variables you need.
#
#               One-time step before the first send:
#                 npx wrangler email sending enable $DOMAIN
#
# Switching is safe in either direction; your mail is untouched.
# MAIL_PROVIDER=resend

# Also expose the app on its *.workers.dev hostname.
# Off by default — a second public door to your mailbox is a liability, not a
# feature. Turn it on only if you are not using a custom domain.
# WORKERS_DEV_URL=false

# Password for the web UI. If blank, a strong one is generated on first deploy,
# saved to .secrets/ and printed to your terminal exactly once.
# APP_PASSWORD=

# Cloudflare account ID. Auto-discovered from your API token — only set this if
# your token can see more than one account.
# CLOUDFLARE_ACCOUNT_ID=

# Passphrase Alchemy uses to encrypt the secrets it stores in .alchemy/. If
# blank, one is generated on first deploy and kept in .secrets/ with the rest.
# Set it only in CI, where a file on the build machine is the wrong place for
# it — and keep it stable, since state cannot be read under a new passphrase.
# ALCHEMY_PASSWORD=

# DMARC policy to publish when your domain does not already have one:
# none (default, monitor only), quarantine, or reject. Postbox never replaces
# a DMARC record you already have. Tighten this once you are confident that
# everything sending as your domain is passing SPF and DKIM.
# DMARC_POLICY=none
