# ─────────────────────────────────────────────────────────────────────────────
#  Postbox — required configuration
#
#  Copy to `.env` and fill in the three values below. That is the whole setup.
#  Everything else in this file is optional and has a derived default.
#
#      cp .env.example .env && just up
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] The domain you send and receive mail on. Must already be a zone in
# your Cloudflare account (nameservers pointing at Cloudflare).
#   e.g. DOMAIN=acme.dev  ->  you@acme.dev, mail hosted at mail.acme.dev
DOMAIN=

# [REQUIRED] Cloudflare API token.
#   Create one at https://dash.cloudflare.com/profile/api-tokens using the
#   "Edit Cloudflare Workers" template, then ADD these permissions:
#     Account -> Workers Scripts       -> Edit
#     Account -> Workers KV Storage    -> Edit
#     Account -> D1                    -> Edit
#     Account -> Email Routing Addresses -> Edit
#     Zone    -> Zone                  -> Read
#     Zone    -> Zone Settings         -> Edit
#     Zone    -> DNS                   -> Edit
#     Zone    -> Email Routing Rules   -> Edit
#     Zone    -> Workers Routes        -> Edit
#   Zone Settings is the one people miss: turning Email Routing on is a zone
#   settings write, whatever its name suggests, and without it the deploy gets
#   six resources in before Cloudflare says "Authentication error".
#   Or skip the token entirely: `just login` signs in with Cloudflare and asks
#   which account to use, and `just token` then mints the token for you.
#
#   This line wins over any CLOUDFLARE_API_TOKEN exported in your shell. Leave it
#   blank and `just up` will ask which token to use — a token that merely happens
#   to be in your environment is never taken as the answer, because when it is
#   the wrong one your mailbox lands in another account without a word.
CLOUDFLARE_API_TOKEN=

# [REQUIRED] Resend API key with **Full access** (https://resend.com/api-keys).
#   Used ONCE, at provision time, to register your domain and to mint a
#   narrower send-only key. The send-only key is what the app actually runs on;
#   it is cached in .secrets/ and reused on every later deploy.
#   Resend's free tier: 3,000 emails/month, 100/day. No card required.
RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
#  Optional — every one of these is derived if you leave it blank.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment stage. Lets you run an isolated copy (`prod`, `staging`, `pr-42`).
# Resources are suffixed with it, so stages never collide.
#   default: prod
# STAGE=prod

# Where the UI is served from.
#   default: mail.$DOMAIN  (a free Cloudflare custom domain on your zone)
# APP_HOSTNAME=mail.acme.dev

# The identity Compose starts with.
#   default: hello@$DOMAIN
# DEFAULT_FROM=hello@acme.dev

# Also forward every inbound message to a normal mailbox, as a safety net.
# Cloudflare emails this address a one-click verification link the first time.
# Leave blank to keep all mail exclusively inside Postbox.
# FORWARD_TO=you@gmail.com

# Resend region for the sending domain: us-east-1 | eu-west-1 | sa-east-1 | ap-northeast-1
#   default: us-east-1
# RESEND_REGION=us-east-1

# Who sends your outgoing mail.
#
#   resend      (default) Free. 100/day, 3,000/month. Works on a free
#               Cloudflare account. Needs RESEND_API_KEY above.
#
#   cloudflare  Cloudflare's own Email Sending. No third party and no second
#               credential, but it REQUIRES THE WORKERS PAID PLAN ($5/month),
#               so it is not free. On this setting RESEND_API_KEY is ignored
#               and you can leave it blank — DOMAIN and CLOUDFLARE_API_TOKEN
#               are then the only variables you need.
#
#               One-time step before the first send:
#                 npx wrangler email sending enable $DOMAIN
#
# Switching is safe in either direction; your mail is untouched.
# MAIL_PROVIDER=resend

# Also expose the app on its *.workers.dev hostname.
# Off by default — a second public door to your mailbox is a liability, not a
# feature. Turn it on only if you are not using a custom domain.
# WORKERS_DEV_URL=false

# Password for the web UI. If blank, a strong one is generated on first deploy,
# saved to .secrets/ and printed to your terminal exactly once.
# APP_PASSWORD=

# Cloudflare account ID. Auto-discovered from your API token — only set this if
# your token can see more than one account.
# CLOUDFLARE_ACCOUNT_ID=

# Accept the Cloudflare credential from the environment instead of this file.
# For CI, which has no terminal to answer the prompt `just up` would otherwise
# show, and where exporting a secret is already a deliberate act. On a laptop,
# put the token in this file instead — that is the same statement, in writing.
# POSTBOX_ALLOW_ENV_TOKEN=

# Passphrase Alchemy uses to encrypt the secrets it stores in .alchemy/. If
# blank, one is generated on first deploy and kept in .secrets/ with the rest.
# Set it only in CI, where a file on the build machine is the wrong place for
# it — and keep it stable, since state cannot be read under a new passphrase.
# ALCHEMY_PASSWORD=

# ── Deliverability ──────────────────────────────────────────────────────────
#
# Sending mail is easy; being read is not. Postbox publishes everything a
# receiving server checks, but the records below are the ones you may want to
# make a decision about. `just mailcheck` reports on all of them at any time,
# and docs/DELIVERABILITY.md explains what each one buys you.

# DMARC policy to publish when your domain does not already have one:
# none (default, monitor only), quarantine, or reject. Postbox never replaces
# a DMARC record you already have.
#
# Leave it at none until DMARC_RUA reports show your own mail passing — usually
# a week or two — then move to quarantine. A published policy that is actually
# enforced is a positive signal in its own right, and it is what stops other
# people sending as you. Go to reject only after quarantine has been quiet.
# DMARC_POLICY=none

# Where receivers mail DMARC aggregate reports — a daily XML summary, per
# sending IP, of who sent as your domain and whether it authenticated.
#
# Defaults to dmarc@DOMAIN, which needs no setup: the catch-all already
# delivers it into Postbox. Without this, DMARC is write-only — you publish a
# policy and never learn whether it is right, which makes every later decision
# to tighten it a guess.
#
# The reports are gzipped XML, so if a daily attachment in your inbox is not
# what you want, point this at a free analyser that mails you a summary
# instead (Postmark's is free and needs no account with them):
#   DMARC_RUA=mailto:your-name@dmarc.postmarkapp.com
# An address on somebody else's domain only works if they publish an
# authorisation record — `just mailcheck` tells you if they have not.
# Set to `off` to publish no rua at all.
# DMARC_RUA=mailto:dmarc@example.com

# Apply the policy to only a percentage of failing mail, for a staged
# rollout — pct=25 quarantines a quarter of failures and leaves the rest.
# Useful for one week between none and quarantine on a busy domain.
# DMARC_PCT=100

# Where receivers mail TLS delivery reports (RFC 8460). One TXT record, no
# moving parts, and the only way to find out that mail *to* you is failing to
# negotiate encryption. Defaults to tls-reports@DOMAIN. `off` to skip.
# TLS_RPT=mailto:tls-reports@example.com

# MTA-STS: tells senders that mail for your domain must go over authenticated
# TLS to your real MX hosts, closing the downgrade attack plain SMTP allows.
#
#   off       (default) publish nothing
#   testing   publish the policy, refuse nothing, collect TLS reports
#   enforce   a downgraded or unauthenticated connection is a hard failure
#
# Not off by default because it is risky — testing mode cannot lose mail — but
# because it stands up a second hostname (mta-sts.DOMAIN) and its own small
# Worker to serve the policy file. Run testing for a few weeks, confirm the
# TLS reports are clean, then switch to enforce.
# MTA_STS=off

# Claim the domain in Google Postmaster Tools, which is the only place Gmail
# will tell you your own spam-complaint rate and domain reputation — the two
# numbers that actually decide inbox placement, and which nothing else exposes.
# Start at https://postmaster.google.com, choose DNS TXT verification, and put
# the value here (with or without the google-site-verification= prefix).
# SITE_VERIFICATION=abc123...
